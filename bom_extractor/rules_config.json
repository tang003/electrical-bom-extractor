{
  "version": "1.0.0",
  "description": "工业电控柜 BOM 提取与企业标准选型规则配置库",
  "filter_rules": {
    "exclude_zero_quantity": true,
    "exclude_remarks_without_valid_model": ["液压站部件"],
    "valid_model_prefixes_when_hydraulic": ["MEG", "ES680", "RXLG", "MD500"],
    "exclude_placeholder_models": [
      "^DT\\d+$",
      "^SP\\d+$",
      "^LF60D-DPAA1S120F675NB$"
    ],
    "exclude_field_load_tags": ["-M1", "-M2", "-M3", "-M4", "-R1", "-R2", "-YV1", "-YV2", "-YV3", "-YV4A", "-YV4B", "FP1", "FP2", "FP3", "FP4", "FP5", "FP6"]
  },
  "plc_accessory_rules": [
    {
      "match_model": "6ES7 531-7KF00-0AB0",
      "append_model": "+6ES7592-1BM00-0XB0",
      "reason": "西门子 S7-1500 8AI 模块标准配 40 针前连接器 (6ES7592-1BM00-0XB0)"
    },
    {
      "match_model": "6ES7 511-1AL03-0AB0",
      "append_model": "+6ES7590-1AB60-0AA0+6ES7954-8LL04-0AA0",
      "reason": "西门子 CPU 1511-1 PN 标准配 160mm 导轨 (1AB60) 及存储卡 (8LL04)"
    }
  ],
  "breaker_normalization_rules": [
    {
      "pattern": "EZD250M\\s*3P\\s*250A",
      "brand": "施耐德",
      "name": "断路器",
      "model": "EZD250M3250N+ EZDFASB2",
      "reason": "施耐德 EZD250M 3P 250A 塑壳断路器标准订货号及报警/辅助附件"
    },
    {
      "pattern": "EZD160M\\s*3P\\s*125A",
      "brand": "施耐德",
      "name": "断路器",
      "model": "EZD160M3125N+ EZDFASB2",
      "reason": "施耐德 EZD160M 3P 125A 塑壳断路器标准订货号及报警/辅助附件"
    },
    {
      "pattern": "GV2ME16C",
      "brand": "施耐德",
      "name": "马达保护断路器",
      "model_with_aux": "GV2ME16C+GVAE11",
      "model_default": "GV2ME16C",
      "reason": "控制回路使用到了热磁断路器辅助触点，自动配 +GVAE11"
    },
    {
      "pattern": "GV2ME10C",
      "brand": "施耐德",
      "name": "马达保护断路器",
      "model_with_aux": "GV2ME10C+GVAE11",
      "model_default": "GV2ME10C",
      "reason": "控制回路使用到了热磁断路器辅助触点，自动配 +GVAE11"
    },
    {
      "pattern": "GV2ME20C",
      "brand": "施耐德",
      "name": "马达保护断路器",
      "model_with_aux": "GV2ME20C+GVAE11",
      "model_default": "GV2ME20C",
      "reason": "控制回路使用到了热磁断路器辅助触点，自动配 +GVAE11"
    },
    {
      "pattern": "IC65N\\s*2P\\s*C4A?",
      "brand": "施耐德",
      "name": "断路器",
      "model": "IC65N 2P C4"
    },
    {
      "pattern": "IC65N\\s*1P\\s*C6A?",
      "brand": "施耐德",
      "name": "断路器",
      "model": "IC65N 1P C6"
    },
    {
      "pattern": "i?C65N-?C2A?/1P|IC65N\\s*1P\\s*C2A?",
      "brand": "施耐德",
      "name": "断路器",
      "model": "IC65N 1P C2"
    }
  ],
  "panel_series_rules": {
    "series_name": "施耐德 XB2 / RXM 标准系列",
    "indicator_lights": {
      "白": {"brand": "施耐德", "name": "白色指示灯", "model": "XB2BVB1LC"},
      "绿": {"brand": "施耐德", "name": "绿色指示灯", "model": "XB2BVM3LC"},
      "红": {"brand": "施耐德", "name": "红色指示灯", "model": "XB2BVM4LC"},
      "黄": {"brand": "施耐德", "name": "黄色指示灯", "model": "XB2BVM5LC"}
    },
    "buttons_and_switches": {
      "emergency_stop": {"brand": "施耐德", "name": "急停按钮", "model": "XB2BS542C"},
      "push_button": {"brand": "施耐德", "name": "启动按钮", "model": "XB2BA31C"},
      "selector_2pos": {"brand": "施耐德", "name": "旋转开关", "model": "XB2BD21C"},
      "selector_3pos": {"brand": "施耐德", "name": "旋转开关", "model": "XB2BD31C"},
      "buzzer": {"brand": "施耐德", "name": "蜂鸣器", "model": "XB2BSB4LC"}
    },
    "intermediate_relay": {
      "brand": "施耐德",
      "name": "中间继电器",
      "model": "RXM2LB2BD+RXZE1M2C",
      "default_coil_count": 30
    },
    "cabinet_fan": {
      "brand": "优质国产",
      "name": "风扇+过滤网",
      "model": "223*223",
      "quantity_per_fan_symbol": 2
    }
  },
  "auxiliary_estimation_rules": {
    "enable_for_schematic_mode": true,
    "cabinet_default_brand": "XSH",
    "cabinet_default_name": "仿威图电柜",
    "labor_item": {"brand": "XSH", "name": "人工", "model": "", "unit": "个", "quantity": 1},
    "wire_defaults": [
      {"model": "70mm²", "brand": "国产", "name": "导线", "unit": "米", "quantity": 9},
      {"model": "16mm²", "brand": "国产", "name": "导线", "unit": "米", "quantity": 20},
      {"model": "4mm²", "brand": "国产", "name": "导线", "unit": "米", "quantity": 20},
      {"model": "2.5mm²", "brand": "国产", "name": "导线", "unit": "米", "quantity": 20},
      {"model": "1mm²", "brand": "国产", "name": "导线", "unit": "米", "quantity": 300}
    ],
    "terminal_defaults": [
      {"model": "250A", "brand": "国产", "name": "端子", "unit": "个", "quantity": 5},
      {"model": "100A", "brand": "国产", "name": "端子", "unit": "个", "quantity": 8},
      {"model": "25A", "brand": "国产", "name": "端子", "unit": "个", "quantity": 8},
      {"model": "16A", "brand": "国产", "name": "端子", "unit": "个", "quantity": 75}
    ]
  }
}
